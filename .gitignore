# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/

# Production / Build outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
tsconfig.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# User-requested exclusions
temp/
public/dist/
**/public/dist/

# Environment files
.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Misc / OS files
.DS_Store
Thumbs.db
*.pem

# Large archives
*.zip
**/*.zip
